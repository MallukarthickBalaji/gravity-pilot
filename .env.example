# DesktopPilot / GravityPilot Environment Configuration

# ── Cloud LLM (Groq) ──────────────────────────────────────────────────────────
# Free API key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Local LLM (Ollama) ────────────────────────────────────────────────────────
# Default local endpoint (http://127.0.0.1:11434) and installed model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest

# ── Server Settings ───────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
